# Open Notebook Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
# root:root is fine for local use. Change these before exposing the instance to a
# network — docker-compose.yml reads them for both the SurrealDB server and the
# app, so the two stay in sync.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# DEPRECATED: AI Provider API Keys (environment-variable fallback)
# =============================================================================
# Configure AI providers via the UI: Manage → Models. Credentials are
# stored encrypted, can be rotated without restarts, and support multiple
# credentials per provider.
#
# The environment variables below are a DEPRECATED fallback. They still work
# today, but there is no guarantee they keep working in future releases, and
# new automation should not be built on them. A declarative provisioning
# contract for headless/CI/Docker setups is being designed in
# https://github.com/lfnovo/open-notebook/discussions/765

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint — DEPRECATED fallback, configure via Manage → Models instead
# OLLAMA_API_BASE=http://localhost:11434

# oMLX (Apple Silicon) — DEPRECATED fallback, configure via Manage → Models instead
# Port 11435 avoids clashing with SurrealDB on 8000
# OMLX_API_BASE=http://localhost:11435/v1
# OMLX_API_KEY=  # optional; only if oMLX was started with --api-key

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Model policy & retrieval flags (defaults shown). These are all opt-in: keep
# the four "false" flags OFF to guarantee no cloud calls and no heavyweight
# local reranking. C2 pins these defaults with a unit test
# (tests/test_flag_defaults.py), so they cannot silently change.
AUTO_MODEL_POLICY=offline-first
CLOUD_ALLOWED=false
USE_ROUTER=false
# USE_MIXTURE also gates hybrid (RRF) search in open_notebook/utils/hybrid_search.py
USE_MIXTURE=false
USE_RERANKER_BEFORE_TRUNCATE=false
PREFER_LOCAL=true
DEGRADE_GRACEFULLY=true
TIME_BUDGETS_ENFORCED=true

# Install Docling on first startup to unlock the docling document engine, OCR
# for scanned/image-only PDFs and image sources (a large ML stack; only the
# first boot is slow). Also select "Docling" as the document engine.
# OPEN_NOTEBOOK_ENABLE_DOCLING=true

# Remote Crawl4AI server for the crawl4ai URL engine (no local install needed).
# Crawl4AI Docker >= 0.9.0 requires a bearer token for external connections.
# CRAWL4AI_API_URL=http://crawl4ai:11235
# CRAWL4AI_API_TOKEN=your-crawl4ai-token

# Max background tasks the worker runs concurrently (default 5). Set to 1 for
# sequential processing on single-GPU / local-LLM setups to avoid rate limits.
# NOTE: consumed at worker launch, not by the app — for `make`/dev-init export
# it in your shell; for Docker set it under `environment:` in docker-compose.yml.
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=1

# Maximum upload/request body size in MB (default: 100). Raise this if you
# need to upload larger audio/video files. A fronting reverse proxy's own
# limit (e.g. nginx client_max_body_size) still applies and should be raised
# to match.
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# Security
# Password to protect this Open Notebook instance. Supports Docker secrets
# via OPEN_NOTEBOOK_PASSWORD_FILE. Auth is fully disabled if unset.
# OPEN_NOTEBOOK_PASSWORD=secret
#
# Opt-in auth guard (B4, default off). With this on, the API refuses to start
# unless OPEN_NOTEBOOK_PASSWORD (or _FILE) is set, instead of silently serving
# every request unauthenticated. Leave unset for offline/dev use.
# OPEN_NOTEBOOK_REQUIRE_AUTH=false

# Network / Proxy (corporate / firewalled environments)
# Route outbound HTTP(S) through a proxy. NO_PROXY MUST list the internal
# SurrealDB hosts (host.docker.internal, surrealdb) — otherwise the DB
# websocket gets tunnelled through the proxy and the worker/API fail to start
# with HTTP 403. The app also injects these hosts automatically as a safety
# net, but keep them here so your config is explicit.
# HTTP_PROXY=http://proxy.corp.com:8080
# HTTPS_PROXY=http://proxy.corp.com:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,surrealdb,.local

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md

# B3 job lifecycle (defaults shown). Heartbeat 120s cuts write
# amplification ~4x vs the old 30s; the stale threshold keeps margin and the
# monitor requires two consecutive stale sightings before marking failed.
# OPEN_NOTEBOOK_HEARTBEAT_SECONDS=120
# OPEN_NOTEBOOK_STALE_JOB_SECONDS=300
# OPEN_NOTEBOOK_JOB_MONITOR_SECONDS=60

# B2 deep-retry visibility. `process_source` retries up to 15 times for
# SurrealDB v2 transaction conflicts and logs each attempt at DEBUG (hidden at
# the worker's INFO level). This surfaces every Nth attempt as a visible
# "retry distribution" line so a stuck command is obvious. Set to 0/off/none
# to silence it; lower the number for more detail.
# OPEN_NOTEBOOK_RETRY_VISIBILITY_STEP=5

# D1 ntfy push notifications (job completed / failed). Fully disabled when
# OPEN_NOTEBOOK_NOTIFY_URL is unset (zero footprint: no connection, no thread;
# the HTTP POST exists only at event time). Point it at an ntfy topic, e.g.
# https://ntfy.sh/your-topic or http://ntfy:80/notebook. Optional bearer token
# for protected topics. Click-through links are added only when
# OPEN_NOTEBOOK_BASE_URL (the web UI origin) is also set.
# OPEN_NOTEBOOK_NOTIFY_URL=https://ntfy.sh/your-topic
# OPEN_NOTEBOOK_NOTIFY_TOKEN=
# OPEN_NOTEBOOK_BASE_URL=http://localhost:8502

# Low-resource envelope tuning (2 GiB)
OPEN_NOTEBOOK_FORCE_MINI_MODELS=true
OPEN_NOTEBOOK_MINI_MODEL_CHAT=mistral-nemo:latest
OPEN_NOTEBOOK_MINI_MODEL_EMBED=nomic-embed-text:latest
OPEN_NOTEBOOK_MINI_MODEL_TRANSFORM=llama3.2:3b-instruct-q4_0
OPEN_NOTEBOOK_DOCLING_FAST_PROFILE=true
# Training capabilities: opt-in AND tier-gated (capability_tier.gate_training).
# Both default to false; setting one to true still requires the machine to
# pass the live tier check (>=3072 MB free + >=2 threads for LoRA).
# OPEN_NOTEBOOK_ALLOW_TINY_TRAIN=true
# OPEN_NOTEBOOK_ALLOW_LORA=true
# No-AVX inference sidecar (T1): when set + allowed, sub-3GB tiers route
# chat/transform inference to this OpenAI-compatible URL instead of loading
# a local model. Host Ollama stays the path otherwise. The sidecar ships in
# docker-compose.sse2.yml (opt-in profile, never default up).
# OPEN_NOTEBOOK_ALLOW_LLAMACPP_SSE2=true
# LLAMACPP_SSE2_URL=http://llamacpp-sse2:8080/v1
# LLAMACPP_SSE2_MODEL=qwen2.5-0.5b
# LLAMACPP_SSE2_API_KEY=sk-no-key-required
# Hibernate policy (inert until a governor reads it; all defaults are safe).
# OPEN_NOTEBOOK_HIBERNATE_ENABLE=true
# OPEN_NOTEBOOK_HIBERNATE_IDLE_SECONDS=600
# OPEN_NOTEBOOK_HIBERNATE_STOP_MEDIA=true
# Resource budgets: percent of detected total system RAM/CPU. Warn-only;
# hard caps are out until governor triggers are proven (see T7).
# OPEN_NOTEBOOK_RESOURCE_WARN_RSS_PCT=75
# OPEN_NOTEBOOK_RESOURCE_WARN_ONLY=true
# Obsidian vault ingest (P7, one-shot scan via ingest_vault command).
# Mount the vault read-only in compose; files are never moved or deleted.
# OPEN_NOTEBOOK_VAULT_DIR=./vault
# Exported study notes land here (on-demand per note, additive-safe names).
# OPEN_NOTEBOOK_EXPORT_DIR=./notebook_export
# Log retention for event tables (revlog, focus_session). Export-then-prune;
# the command table (job history) is never pruned here. Minimum 30 days.
# OPEN_NOTEBOOK_LOG_RETENTION_DAYS=365
# Whisper model ladder (media profile): tiny < base.en (default) < turbo.
# Turbo is opt-in only (~33x encoder FLOPs vs base — wrong for weak CPUs)
# and needs its ~770MB file present in whisper_models/.
# WHISPER_MODEL_FILE=ggml-base.en-q5_1.bin
# WHISPER_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin
