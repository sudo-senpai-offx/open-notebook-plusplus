-- Migration 29 down: un-seal — restore migration 28's HNSW + KNN state.
--
-- Rolling back migration 29 returns the database to the rejected A1 step-1
-- state (HNSW indexes + KNN rewrite of fn::vector_search). Statements are
-- byte-identical to 28.surrealql, so 27 -> 28 -> 29 -> 29_down cycles exactly
-- reproduce migration 28's experiment state; a subsequent rollback of 28
-- (28_down.surrealql) returns to migration 27. This keeps the 28/29 pair fully
-- reversible for audit and any future re-lock of the A1 experiment.

REMOVE FUNCTION IF EXISTS fn::vector_search;

DEFINE INDEX IF NOT EXISTS idx_source_embedding_hnsw ON source_embedding FIELDS embedding HNSW DIMENSION 1024 DIST COSINE TYPE F32 EFC 40 M 12;
DEFINE INDEX IF NOT EXISTS idx_source_insight_hnsw ON source_insight FIELDS embedding HNSW DIMENSION 1024 DIST COSINE TYPE F32 EFC 40 M 12;
DEFINE INDEX IF NOT EXISTS idx_note_hnsw ON note FIELDS embedding HNSW DIMENSION 1024 DIST COSINE TYPE F32 EFC 40 M 12;

DEFINE FUNCTION IF NOT EXISTS fn::vector_search($query: array<float>, $match_count: int, $sources: bool, $show_notes: bool, $min_similarity: float, $notebook_ids: option<array<record<notebook>>>) {

    let $scoped = $notebook_ids != NONE AND array::len($notebook_ids) > 0;
    let $scoped_sources = IF $scoped { (SELECT VALUE in FROM reference WHERE out IN $notebook_ids) } ELSE { [] };
    let $scoped_notes = IF $scoped { (SELECT VALUE in FROM artifact WHERE out IN $notebook_ids) } ELSE { [] };

    let $source_embedding_search =
        IF $sources {(
            SELECT id, parent_id, title, content, similarity FROM (
                SELECT
                    source.id AS id,
                    source.title AS title,
                    content,
                    source.id AS parent_id,
                    source AS scope_key,
                    vector::similarity::cosine(embedding, $query) AS similarity
                FROM source_embedding
                WHERE embedding <|200,200|> $query
            )
            WHERE (!$scoped OR scope_key IN $scoped_sources) AND similarity >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $source_insight_search =
        IF $sources {(
            SELECT id, parent_id, title, content, similarity FROM (
                SELECT
                    id,
                    insight_type + ' - ' + (source.title OR '') AS title,
                    content,
                    source.id AS parent_id,
                    source AS scope_key,
                    vector::similarity::cosine(embedding, $query) AS similarity
                FROM source_insight
                WHERE embedding <|200,200|> $query
            )
            WHERE (!$scoped OR scope_key IN $scoped_sources) AND similarity >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $note_content_search =
        IF $show_notes {(
            SELECT id, parent_id, title, content, similarity FROM (
                SELECT
                    id,
                    title,
                    content,
                    id AS parent_id,
                    vector::similarity::cosine(embedding, $query) AS similarity
                FROM note
                WHERE embedding <|200,200|> $query
            )
            WHERE (!$scoped OR id IN $scoped_notes) AND similarity >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $all_results = array::union(
        array::union($source_embedding_search, $source_insight_search),
        $note_content_search
    );

    RETURN (
        SELECT id, parent_id, title, math::max(similarity) as similarity,
               array::flatten(content) as matches
        FROM $all_results
        WHERE id is not None
        GROUP BY id, parent_id, title
        ORDER BY similarity DESC
        LIMIT $match_count
    );

};