{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/settings/api-keys",
      "destination": "/settings/models",
      "statusCode": 308,
      "regex": "^(?!/_next)/settings/api-keys(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://localhost:5055/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/sources/[sourceId]/chat/sessions/[sessionId]/messages",
      "regex": "^/api/sources/([^/]+?)/chat/sessions/([^/]+?)/messages(?:/)?$",
      "routeKeys": {
        "nxtPsourceId": "nxtPsourceId",
        "nxtPsessionId": "nxtPsessionId"
      },
      "namedRegex": "^/api/sources/(?<nxtPsourceId>[^/]+?)/chat/sessions/(?<nxtPsessionId>[^/]+?)/messages(?:/)?$"
    },
    {
      "page": "/notebooks/[id]",
      "regex": "^/notebooks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/notebooks/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sources/[id]",
      "regex": "^/sources/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/sources/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/advanced",
      "regex": "^/advanced(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/advanced(?:/)?$"
    },
    {
      "page": "/api/search/ask",
      "regex": "^/api/search/ask(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/search/ask(?:/)?$"
    },
    {
